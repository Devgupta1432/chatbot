# Copy this to .env and fill in your values
# Never commit .env to git

PORT=3001

# Comma-separated list of allowed frontend origins (no trailing slash)
# Example for production: https://yourdomain.com,https://widget.pixora.in
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:5500

# Option A: place your Firebase service account JSON as backend/serviceAccount.json
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key

# Option B: paste the entire JSON as a single-line string (recommended for Render/cloud)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
